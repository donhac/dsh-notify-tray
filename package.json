{
  "name": "dsh-notify-tray",
  "version": "0.1.8-donh.1",
  "description": "Donh 自用 Goal 感知 fork。DeepSeek Harness 通知 + 状态栏插件：任务完成、需要输入、需要选择时弹系统通知（macOS / Windows / Linux）；macOS 与 Linux（含 UOS、Deepin、麒麟）状态栏常驻小图标，显示任务进度与花费。Windows 没有状态栏，只弹通知。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "notification",
    "tray",
    "menubar",
    "usage"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "icon": "./icon.webp",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "assets",
    "locale",
    "icon.webp",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "README.en.md",
    "FORK.md"
  ],
  "license": "MIT",
  "author": "ROYLeXJ",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donhac/dsh-notify-tray.git"
  },
  "homepage": "https://github.com/donhac/dsh-notify-tray#readme",
  "bugs": {
    "url": "https://github.com/donhac/dsh-notify-tray/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-force-exit test/*.test.js",
    "version": "node scripts/sync-readme-version.mjs && git add README.md README.zh-CN.md README.en.md",
    "update-prices": "node scripts/update-models-dev.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "dependencies": {
    "dbus-next": "^0.10.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5 || ~4.1.0",
    "@deepseek-ai/schemastery": "~3.18.5 || ~3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
